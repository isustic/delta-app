{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Delta",
  "version": "1.0.4",
  "identifier": "com.ethics.reportsapp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Delta",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/*.xlsx"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQzRjE5NzcyRkE1QzhFMzkKUldRNWpsejZjcGZ4MDNsRSt4ejlaREFpZ1A5a2VWSGcrVnRKWVBodDcrV0tFNkNvUnUzd296RU8K",
      "endpoints": [
        "https://github.com/isustic/delta-app/releases/latest/download/latest.json"
      ]
    }
  }
}
